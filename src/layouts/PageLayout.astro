---
interface Props {
  color: string;
}
const { color  = 'white'} = Astro.props;
---

<!doctype html>
<slot />
<footer class="px-4 py-8 text-center {color}">
  <div class="max-w-5xl mx-auto">
    <div class="flex justify-center mb-4 space-x-6">
      <a href="#">
        <span class="sr-only">GitHub</span>
      </a>

      <a href="#">
        <span class="sr-only">LinkedIn</span>
      </a>

      <a href="#">
        <span class="sr-only">Twitter</span>
      </a>

    </div>
    <p>{new Date().getFullYear()} Adam Wu. All rights reserved.</p>
  </div>
</footer>


