---
// src/pages/index.astro
import Intro from '../components/Introduction.astro'
---

<html lang="en">
  <head>
    <title>Page with Sidebar</title>
    <style>
      html {
        scroll-behavior: smooth;
      }

      body {
        margin: 0;
        font-family: sans-serif;
        display: flex;
      }

      .sidebar {
        width: 200px;
        background-color: #f8f9fa;
        padding: 1rem;
        padding-top: 1rem;
        height: 100vh;
        position: sticky;
        top: 0;
      }

      .sidebar a {
        display: block;
        margin-top: 1rem;
        margin-bottom: 1rem;
        color: #333;
        text-decoration: none;
      }

      .content {
        padding: 2rem;
        padding-top: 1rem;
        flex-grow: 1;
      }

      section {
        border-bottom: 1px solid #ccc;
        padding-bottom: 2rem;
      }
    </style>
  </head>

  <body>
    <aside class="sidebar">
      <a href="#introduction">Introduction</a>
      <a href="#features">Features</a>
      <a href="#contact">Contact</a>
    </aside>

    <main class="content">
      <section id="introduction">
        <h2>Introduction</h2>
        <Intro />
      </section>

      <section id="features">
        <h2>Features</h2>
        <p>Here are some features of this page.</p>
      </section>

      <section id="contact">
        <h2>Contact</h2>
        <p>Reach out to us here.</p>
      </section>
    </main>
  </body>
</html>
