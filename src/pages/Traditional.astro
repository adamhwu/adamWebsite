---
import Layout from '../layouts/PageLayout.astro';
---

<Layout title="John Doe | Personal Website">
  <main class="min-h-screen">
    <!-- Hero Section -->
    <section id="home" class="flex flex-col items-center justify-center min-h-screen px-4 py-16 text-center">
      <div class="max-w-3xl mx-auto">
        <h1 class="mb-6 text-4xl font-bold md:text-6xl">
          Hi, I'm <span class="text-blue-300">John Doe</span>
        </h1>
        <h2 class="mb-8 text-2xl font-medium text-blue-400 md:text-3xl">
          Full Stack Developer
        </h2>
        <p class="mb-10 text-lg text-gray-300">
          I build modern web applications with a focus on performance, accessibility, and user experience.
        </p>
        <div class="flex flex-wrap justify-center gap-4">
          <a href="#contact" class="px-6 py-3 text-lg font-medium transition-colors rounded-md bg-blue-600 hover:bg-blue-700">
            Contact Me
          </a>
          <a href="#projects" class="px-6 py-3 text-lg font-medium transition-colors border rounded-md border-blue-600 hover:bg-blue-900/30">
            View My Work
          </a>
        </div>
      </div>
    </section>

    <!-- Skills Section -->
    <section id="skills" class="px-4 py-16 bg-navy-900">
      <div class="max-w-5xl mx-auto">
        <h2 class="mb-12 text-3xl font-bold text-center md:text-4xl">My Skills</h2>
        <div class="grid grid-cols-2 gap-6 md:grid-cols-3 lg:grid-cols-4">
          {['HTML', 'CSS', 'JavaScript', 'TypeScript', 'React', 'Node.js', 'Astro', 'Tailwind CSS'].map((skill) => (
            <div class="flex flex-col items-center p-4 transition-transform rounded-lg bg-navy-800 hover:transform hover:scale-105">
              <span class="mt-2 font-medium">{skill}</span>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Projects Section -->
    <section id="projects" class="px-4 py-16">
      <div class="max-w-5xl mx-auto">
        <h2 class="mb-12 text-3xl font-bold text-center md:text-4xl">Featured Projects</h2>
        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
          {[1, 2, 3].map((project) => (
            <div class="overflow-hidden transition-transform rounded-lg bg-navy-800 hover:transform hover:scale-105">
              <div class="h-48 bg-navy-700"></div>
              <div class="p-6">
                <h3 class="mb-2 text-xl font-bold">Project {project}</h3>
                <p class="mb-4 text-gray-300">
                  A brief description of this amazing project and the technologies used to build it.
                </p>
                <div class="flex gap-2">
                  <a href="#" class="px-4 py-2 text-sm font-medium transition-colors rounded-md bg-blue-600 hover:bg-blue-700">
                    View Project
                  </a>
                  <a href="#" class="px-4 py-2 text-sm font-medium transition-colors border rounded-md border-blue-600 hover:bg-blue-900/30">
                    Source Code
                  </a>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Contact Section -->
    <section id="contact" class="px-4 py-16 bg-navy-900">
      <div class="max-w-3xl mx-auto">
        <h2 class="mb-12 text-3xl font-bold text-center md:text-4xl">Get In Touch</h2>
        <div class="p-8 rounded-lg bg-navy-800">
          <form class="space-y-6">
            <div class="grid gap-6 md:grid-cols-2">
              <div>
                <label for="name" class="block mb-2 text-sm font-medium">Name</label>
                <input
                  type="text"
                  id="name"
                  class="w-full px-4 py-3 rounded-md bg-navy-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  required
                />
              </div>
              <div>
                <label for="email" class="block mb-2 text-sm font-medium">Email</label>
                <input
                  type="email"
                  id="email"
                  class="w-full px-4 py-3 rounded-md bg-navy-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                  required
                />
              </div>
            </div>
            <div>
              <label for="subject" class="block mb-2 text-sm font-medium">Subject</label>
              <input
                type="text"
                id="subject"
                class="w-full px-4 py-3 rounded-md bg-navy-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                required
              />
            </div>
            <div>
              <label for="message" class="block mb-2 text-sm font-medium">Message</label>
              <textarea
                id="message"
                rows="5"
                class="w-full px-4 py-3 rounded-md bg-navy-700 focus:outline-none focus:ring-2 focus:ring-blue-500"
                required
              ></textarea>
            </div>
            <button
              type="submit"
              class="w-full px-6 py-3 text-lg font-medium transition-colors rounded-md bg-blue-600 hover:bg-blue-700"
            >
              Send Message
            </button>
          </form>
        </div>
      </div>
    </section>
  </main>
</Layout>

